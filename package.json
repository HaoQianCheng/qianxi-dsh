{
  "name": "fujiang-armor",
  "version": "0.4.3",
  "description": "富江破甲",
  "keywords": ["qianxi-dsh", "deepseek", "deepseek-harness", "dsh", "dsh-plugin", "fujiang", "富江", "富江破甲", "提示词", "system-prompt", "npx", "plugin-installer"],
  "engines": { "node": ">=22" },
  "bin": { "qianxi-dsh": "./bin/qianxi-dsh.mjs" },
  "license": "CC-BY-NC-SA-4.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HaoQianCheng/qianxi-dsh.git"
  },
  "homepage": "https://github.com/HaoQianCheng/qianxi-dsh#readme",
  "bugs": {
    "url": "https://github.com/HaoQianCheng/qianxi-dsh/issues"
  },
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./client.js": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "prompts",
    "bin",
    "scripts/install",
    "scripts/ensure-runtime.ps1",
    "scripts/lib",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "harness:check": "node --check index.js && node --check client.js && node --check bin/qianxi-dsh.mjs",
    "verify": "node --test tests/plugin.test.mjs tests/cli.test.mjs && node tests/scorer.test.mjs",
    "verify:package": "node tests/package-smoke.mjs"
  },
  "dsh": {
    "id": "fujiang-armor",
    "name": "富江破甲",
    "version": "0.4.3",
    "permissions": "系统提示词注入, 客户端状态条",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
